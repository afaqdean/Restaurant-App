    "pdfmake": "^0.2.20",
    "puppeteer": "^24.19.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-hot-toast": "^2.6.0",
    "rimraf": "^6.0.1",
